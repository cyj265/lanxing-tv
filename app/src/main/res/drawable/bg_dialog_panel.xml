<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈半透明描边模拟阴影，与 bg_settings_card 的分层思路一致 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66111827" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_panel" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#33415F" />
        </shape>
    </item>
</layer-list>
